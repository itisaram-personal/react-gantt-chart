{
  "name": "@gantt-chart/echarts",
  "version": "0.1.0",
  "description": "ECharts custom-series adapter for the Gantt engine.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gantt-chart/core": "^0.1.0"
  },
  "peerDependencies": {
    "echarts": "^5.4.0"
  },
  "devDependencies": {
    "echarts": "^5.5.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
