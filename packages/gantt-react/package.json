{
  "name": "@gantt-chart/react",
  "version": "0.1.10",
  "description": "React components and hooks for the high-performance ECharts Gantt chart.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itisaram-personal/react-gantt-chart.git",
    "directory": "packages/gantt-react"
  },
  "homepage": "https://github.com/itisaram-personal/react-gantt-chart#readme",
  "bugs": "https://github.com/itisaram-personal/react-gantt-chart/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gantt-chart/core": "^0.1.10",
    "@gantt-chart/echarts": "^0.1.10",
    "@gantt-chart/themes": "^0.1.10",
    "echarts": "^5.4.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
