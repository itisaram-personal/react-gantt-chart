{
  "name": "@gantt-chart/themes",
  "version": "0.1.9",
  "description": "Light and dark themes for the Gantt chart.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itisaram-personal/react-gantt-chart.git",
    "directory": "packages/gantt-themes"
  },
  "homepage": "https://github.com/itisaram-personal/react-gantt-chart#readme",
  "bugs": "https://github.com/itisaram-personal/react-gantt-chart/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gantt-chart/core": "^0.1.9"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
